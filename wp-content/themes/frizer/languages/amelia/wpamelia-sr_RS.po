msgid ""
"<p>Dear <strong>%customer_full_name%</strong>,</p><p><br></p><p>You have "
"successfully purchased several appointments. The details about your bookings "
"are shown below.</p><p><br></p><p>%cart_appointments_details%.</p><p><br></"
"p><p>Thank you for choosing our company,</p><p><strong>%company_name%</"
"strong></p>"
msgstr ""
"<p>Poštovani <strong>%customer_full_name%</strong>,</p><p><br></p><p>Uspešno "
"ste kupili nekoliko termina. Detalji o vašim rezervacijama prikazani su u "
"nastavku.</p><p><br></p><p>%cart_appointments_details%.</p><p><br></"
"p><p>Hvala što ste izabrali našu kompaniju,</p><p><strong>%company_name%</"
"strong></p>"

msgid ""
"<p>Hi <strong>%employee_full_name%</strong>,</p><p><br></p><p>Customer "
"<strong>%customer_full_name%</strong> has successfully scheduled several "
"appointments. The details about bookings are shown below.</p><p><br></"
"p><p>%cart_appointments_details%</p><p><br></p><p>Thank you,</"
"p><p><strong>%company_name%</strong></p>"
msgstr ""
"<p>Zdravo <strong>%employee_full_name%</strong>,</p><p><br></p><p>Kupac "
"<strong>%customer_full_name%</strong> je uspešno zakazao nekoliko termina. "
"Detalji o rezervacijama prikazani su u nastavku.</p><p><br></"
"p><p>%cart_appointments_details%</p><p><br></p><p>Hvala,</"
"p><p><strong>%company_name%</strong></p>"

