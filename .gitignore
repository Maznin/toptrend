# Global
node_modules/
.idea
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip
*.ddev

# ignore everything in the root except the "wp-content" directory and  .gitignore file.
/*
!.gitignore
!.github/
!.github/workflows/
!.github/workflows/deploy-theme.yml
!wp-content/

# project specific track/ignore
wp-content/*
# plugins
!wp-content/plugins/
wp-content/plugins/*
!wp-content/plugins/hairstylist-blocks
# themes
!wp-content/themes/
wp-content/themes/*
!wp-content/themes/toptrend/
!wp-content/themes/frizer/
!wp-content/themes/twentytwentyfive/




